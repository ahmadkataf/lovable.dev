{
  "name": "dentora-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "dev": "node scripts/build-public.mjs && wrangler dev --local",
    "deploy": "node scripts/fetch-published.mjs && node scripts/build-public.mjs && wrangler deploy",
    "fetch-published": "node scripts/fetch-published.mjs",
    "check": "node scripts/build-public.mjs && tsc -p . && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "vitest run",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.141.0"
  }
}
