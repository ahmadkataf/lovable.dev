{
  "name": "kaseb-api",
  "private": true,
  "type": "module",
  "description": "Kaseb license server: online activation, periodic verification and the seller's codes page (Cloudflare Worker + D1)",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 execute kaseb --local --file=schema.sql"
  },
  "dependencies": {
    "@noble/ed25519": "^3.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260925.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.141.0"
  }
}
