{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.kasher.pos",
  "productName": "Kasher POS",
  "copyright": "Kasher",
  "directories": { "output": "release", "buildResources": "build" },
  "files": ["dist/**", "electron/**", "package.json", "!electron/**/*.test.cjs", "!node_modules/**"],
  "asar": true,
  "compression": "normal",
  "afterPack": "scripts/after-pack.cjs",
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "build/icon.ico",
    "artifactName": "Kasher-POS-Setup-${version}.${ext}",
    "legalTrademarks": "Kasher"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Kasher POS",
    "installerLanguages": ["ar_SA", "en_US"],
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  },
  "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Office" },
  "mac": { "target": ["dmg"], "icon": "build/icon.png", "category": "public.app-category.business" }
}
