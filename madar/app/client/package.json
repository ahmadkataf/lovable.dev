{
  "name": "madar-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "مَدار — client PWA (Vite + React 18 + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:mock": "VITE_MOCK=1 tsc --noEmit -p tsconfig.json && VITE_MOCK=1 vite build --outDir dist-mock",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icons": "node scripts/icons.mjs",
    "qa": "node scripts/qa.mjs",
    "preview:mock": "vite preview --outDir dist-mock --port 4173 --strictPort"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.0"
  }
}
