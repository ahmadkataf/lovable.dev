{
  "name": "madar-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "dev:api": "wrangler dev --local --port 8787 --config wrangler.local.toml",
    "db:local": "wrangler d1 execute madar --local --config wrangler.local.toml --file=schema.sql && wrangler d1 execute madar --local --config wrangler.local.toml --file=seed.sql",
    "seed:gen": "node scripts/gen-seed.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
