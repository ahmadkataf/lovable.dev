   "pauses": []
  },
  {
   "id": "L6",
   "start": 23.221,
   "end": 28.288,
   "voice_end": 28.0,
   "text": "وَمَسَاحَةٌ مَفْتُوحَةٌ، بِإِطْلَالَةٍ عَلَى الْمَدِينَةِ وَضَوْءٍ طَبِيعِيٍّ.",
   "screen": "إطلالة وضوء طبيعي",
   "pauses": []
  },
  {
   "id": "L7",
   "start": 28.288,
   "end": 33.221,
   "voice_end": 32.933,
   "text": "إِنْتَرْنِتٌ سَرِيعٌ، وَتَكْيِيفٌ، وَقَهْوَتُكَ تَصِلُ إِلَى طَاوِلَتِكَ.",
   "screen": "قهوتك تصل إلى طاولتك",
