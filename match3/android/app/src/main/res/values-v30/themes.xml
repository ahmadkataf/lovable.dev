        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>

    <style name="Theme.Zumurud.Starting" parent="Base.Theme.Zumurud.Starting">
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
