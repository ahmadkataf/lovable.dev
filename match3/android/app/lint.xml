<?xml version="1.0" encoding="utf-8"?>
<!-- Lint configuration: justified suppressions only, each with its reason. -->
<lint>
    <!--
        The app IS a JavaScript game. The WebView only ever executes the files bundled in the APK:
        every navigation and every request to another origin is refused (LocalContent.kt), network
        loads are blocked, and file/content access is off — there is no untrusted script to inject.
    -->
    <issue id="SetJavaScriptEnabled">
        <ignore path="src/main/kotlin/com/zumurud/game/MainActivity.kt" />
    </issue>

    <!--
        drawable-xxhdpi holds a single image, the splash-screen emblem, on purpose: one 864px WebP
        (288dp at xxhdpi) is scaled by the system for the other densities, instead of shipping the
        same picture five times. The launcher icons do come in every density (mipmap-*).
    -->
    <issue id="IconMissingDensityFolder" severity="ignore" />
</lint>
