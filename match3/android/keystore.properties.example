# Copy to android/keystore.properties (git-ignored) and fill in, or set the environment variables
# ZUMURUD_KEYSTORE, ZUMURUD_KEYSTORE_PASSWORD, ZUMURUD_KEY_ALIAS, ZUMURUD_KEY_PASSWORD instead.
# Without either, release builds are signed with the debug key and are NOT FOR GOOGLE PLAY.
#
# storeFile is resolved relative to the android/ directory unless it is absolute.
storeFile=/absolute/path/to/zumurud-upload.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me
