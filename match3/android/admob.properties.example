# AdMob ids of the "ads" flavour. Copy to android/admob.properties and fill in — or set the same
# three names as environment variables, or pass them as -P properties. They are not secrets (they
# can be read out of any published app), so this file may be committed if that is convenient.
#
# Where to find them: AdMob → Apps → (the app) → App settings (app id, with a "~"),
# and AdMob → Apps → (the app) → Ad units (one REWARDED and one INTERSTITIAL unit, each with a "/").
#
# Without them the ads flavour falls back to Google's public SAMPLE ids: test ads only. Debug builds
# are fine with that; a release build is refused unless -PallowTestAds=true is given (and is then
# named "…-TESTADS": never upload it).
ADMOB_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_REWARDED_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_INTERSTITIAL_ID=ca-app-pub-0000000000000000/0000000000

# Debug builds only (ignored by release builds):
#   devices that get test ads and the test consent flow even with real ids, comma separated — the
#   id of a device is printed to Logcat by the ad and consent SDKs on first use
#ADS_TEST_DEVICE_IDS=33BE2250B43518CCDA7DE426D04EE231
#   pretend to be in a consent region, to see the consent form anywhere: EEA, REGULATED_US_STATE or OTHER
#UMP_DEBUG_GEOGRAPHY=EEA
